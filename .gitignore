# Hidden directories, with exceptions for shared project files
.*/
!/.github/
!/.well-known/
!/public/.well-known/
!/.yarn/

# Dependencies
node_modules/
/.pnp
.pnp.*
/.yarn/*
!/.yarn/patches/
!/.yarn/plugins/
!/.yarn/releases/
!/.yarn/versions/

# Build, generated files, and test output
/out/
/build/
/coverage/
next-env.d.ts
*.tsbuildinfo

# Local environment, keys, and OTP exports
.env
.env.*
.envrc
!/.env.example
*.pem
*.key
otp-backup-*.json

# Logs and OS metadata
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.DS_Store
Thumbs.db
Desktop.ini
